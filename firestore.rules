rules_version = '2';

// Threat model: a 10-person workshop where the owner knows everyone.
// The rules stop the realistic problems — a worker editing their own past
// punches, punching in for a colleague, or deleting a record — rather than
// trying to be bank-grade without a server.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Anyone signed in can read the workshop settings (the app needs the
    // coordinates and radius). Nobody can read the owner PIN hash usefully.
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /workers/{workerId} {
      allow read: if signedIn();
      // Names, pay rates and PIN hashes cannot be edited from the app at all.
      // Only the device link and the active flag can change, which is what
      // "Unlink phone" and "Remove from roster" need. To change someone's
      // salary, remove them and add them again, or edit in the Firebase console.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['deviceUid', 'active']);
      allow create, delete: if signedIn();
    }

    match /punches/{punchId} {
      allow read: if signedIn();

      // A punch must be stamped by the server clock, carry a real location,
      // and come from the device linked to that worker.
      allow create: if signedIn()
        && request.resource.data.at == request.time
        && request.resource.data.deviceUid == request.auth.uid
        && request.resource.data.type in ['in', 'out']
        && request.resource.data.distanceM is number
        && request.resource.data.distanceM <=
             get(/databases/$(database)/documents/config/workshop).data.radiusM
        && get(/databases/$(database)/documents/workers/$(request.resource.data.workerId))
             .data.deviceUid == request.auth.uid;

      // Attendance history is append-only from the app.
      // Corrections are made by the owner in the Firebase console.
      allow update, delete: if false;
    }

    // The owner's corrections. Kept apart from `punches` on purpose: staff
    // punches remain permanently unalterable, and every fix is an extra record
    // rather than a silent edit, so the history stays auditable.
    match /adjustments/{adjId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // Restored attendance history. It cannot go back into `punches` — that
    // collection demands the server's own clock on every write, which is what
    // makes a punch unforgeable. So a restore lands here instead, plainly
    // marked, and the app reads both. Live punches stay untouchable; anything
    // that came out of a backup is visibly labelled as restored.
    match /archive/{recId} {
      allow read: if signedIn();
      allow create, delete: if signedIn();
      allow update: if false;
    }

    match /holidays/{date} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
  }
}
